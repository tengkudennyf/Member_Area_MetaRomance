# §29 — Minimal env. Service role = server-side only, never expose.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=isi-publishable-key-di-sini
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key-di-sini

# Server-only. API key ini untuk email transaksi aplikasi (order/approval/access).
# Email konfirmasi/reset Supabase diatur terpisah lewat Brevo SMTP di dashboard Supabase.
BREVO_API_KEY=
EMAIL_FROM="Meta Romance <noreply@metaromance.web.id>"

NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_MAIN_SITE_URL=http://localhost:3000
# Produksi: https://member.metaromance.web.id / https://metaromance.web.id

# DEMO_MODE=true → paksa mode demo lokal (DEV ONLY, data JSON di ./data).
# Kosongkan/auto: demo aktif otomatis bila Supabase belum diset.
# DEMO_MODE=

# S3: rate limit global (wajib sebelum traffic besar / multi-instance Vercel).
# Buat Redis gratis di upstash.com → copy REST URL + REST TOKEN ke sini + Vercel env.
# Kosong = fallback in-memory per instance (dev / trafik kecil).
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# Future (Phase 7):
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# XENDIT_SECRET_KEY=
